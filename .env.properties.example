# Copia este archivo como ".env.properties" (en la raíz del proyecto) y pon tus valores.
# .env.properties está en el .gitignore: NUNCA se sube a GitHub.

# Clave para firmar los tokens JWT: al menos 32 caracteres, aleatoria y secreta.
# Para generar una segura en PowerShell (generador criptográfico, no Get-Random):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=pon-aqui-una-clave-aleatoria-de-al-menos-32-caracteres
